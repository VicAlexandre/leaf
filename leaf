#!/usr/bin/env python3
"""leaf: a small e-ink EPUB reader (GTK3 + WebKitGTK, rendering by foliate-js).

  leaf [BOOK.epub]     open a book, or the library of recent books

Keys (in the reader): ←/→ h/l space  page · t contents · +/- text size ·
d paper/ink · s page sound · b library · o open file · q quit

State: ~/.local/state/leaf/library.json (positions, settings)
Files: app/ and foliate-js/ next to this script (symlinks are followed),
       or $LEAF_HOME if set. foliate-js is MIT-licensed, by John Factotum.
"""

import json
import mimetypes
import os
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote, urlparse

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gio, GLib, Gtk, WebKit2  # noqa: E402

HOME = Path.home()
SHARE = Path(os.environ.get("LEAF_HOME") or Path(__file__).resolve().parent)
STATE = HOME / ".local/state/leaf/library.json"
ROOTS = {"app": SHARE / "app", "foliate": SHARE / "foliate-js"}
DEFAULT_SETTINGS = {"theme": "paper", "fontSize": 19, "pageSound": False}
TAP = HOME / ".config/pomo/tap.wav"

mimetypes.add_type("text/javascript", ".js")
mimetypes.add_type("text/javascript", ".mjs")
mimetypes.add_type("application/wasm", ".wasm")


def load_state():
    try:
        s = json.loads(STATE.read_text())
    except (OSError, ValueError):
        s = {}
    s.setdefault("books", {})
    s["settings"] = {**DEFAULT_SETTINGS, **s.get("settings", {})}
    return s


def save_state(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s, indent=1))
    tmp.replace(STATE)


class Leaf(Gtk.Window):
    def __init__(self, book=None):
        super().__init__(title="leaf")
        self.set_default_size(1100, 820)
        self.state = load_state()
        self.book = Path(book).resolve() if book else None
        self.tap_ready = False

        ctx = WebKit2.WebContext.get_default()
        ctx.register_uri_scheme("leaf", self.serve)
        sec = ctx.get_security_manager()
        sec.register_uri_scheme_as_secure("leaf")
        sec.register_uri_scheme_as_cors_enabled("leaf")

        ucm = WebKit2.UserContentManager()
        ucm.register_script_message_handler("leaf")
        ucm.connect("script-message-received::leaf", self.on_message)
        self.view = WebKit2.WebView.new_with_user_content_manager(ucm)
        st = self.view.get_settings()
        st.set_enable_developer_extras(bool(os.environ.get("LEAF_DEBUG")))
        st.set_javascript_can_open_windows_automatically(False)
        st.set_enable_write_console_messages_to_stdout(bool(os.environ.get("LEAF_DEBUG")))
        self.view.connect("decide-policy", self.on_policy)
        self.view.set_background_color(self.bg_rgba())
        self.add(self.view)
        self.connect("destroy", Gtk.main_quit)
        self.load()

    # ── content ──────────────────────────────────────────────────────────────
    def bg_rgba(self):
        from gi.repository import Gdk
        c = Gdk.RGBA()
        c.parse("#1C1C1A" if self.state["settings"]["theme"] == "ink" else "#EEEDE8")
        return c

    def load(self):
        page = "reader.html" if self.book else "library.html"
        self.view.load_uri(f"leaf://reader/app/{page}?t={time.time_ns()}")

    def serve(self, req):
        path = unquote(urlparse(req.get_uri()).path).lstrip("/")
        try:
            if path == "book":
                data, mime = self.book.read_bytes(), "application/epub+zip"
            elif path == "state.json":
                data, mime = json.dumps(self.page_state()).encode(), "application/json"
            else:
                root_name, _, rest = path.partition("/")
                root = ROOTS[root_name].resolve()
                f = (root / rest).resolve()
                if root not in f.parents or not f.is_file():
                    raise FileNotFoundError(path)
                data = f.read_bytes()
                mime = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
            stream = Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(data))
            req.finish(stream, len(data), mime)
        except (OSError, KeyError) as e:
            req.finish_error(GLib.Error.new_literal(Gio.io_error_quark(), str(e), Gio.IOErrorEnum.NOT_FOUND))

    def page_state(self):
        s = self.state
        recent = sorted(((p, b) for p, b in s["books"].items() if Path(p).exists()),
                        key=lambda kv: kv[1].get("opened", 0), reverse=True)
        out = {"settings": s["settings"],
               "recent": [{"path": p, "title": b.get("title") or Path(p).stem, "author": b.get("author", ""),
                           "fraction": b.get("fraction", 0)} for p, b in recent[:30]]}
        if self.book:
            entry = s["books"].get(str(self.book), {})
            out["book"] = {"name": self.book.name, "cfi": entry.get("cfi")}
        return out

    # ── messages from the page ───────────────────────────────────────────────
    def on_message(self, _ucm, result):
        try:
            value = result.get_js_value() if hasattr(result, "get_js_value") else result
            msg = json.loads(value.to_json(0))
        except Exception:
            return
        kind = msg.get("type")
        s = self.state
        if kind == "progress" and self.book:
            e = s["books"].setdefault(str(self.book), {})
            e.update({k: msg[k] for k in ("cfi", "fraction", "title", "author") if msg.get(k) is not None})
            e["opened"] = time.time()
            save_state(s)
            self.set_title(f"{msg.get('title') or self.book.stem} · leaf")
        elif kind == "settings":
            s["settings"].update({k: v for k, v in msg.get("settings", {}).items() if k in DEFAULT_SETTINGS})
            save_state(s)
            self.view.set_background_color(self.bg_rgba())
        elif kind == "turn" and s["settings"].get("pageSound"):
            self.tap()
        elif kind == "open" and msg.get("path"):
            self.open_book(msg["path"])
        elif kind == "library":
            self.book = None
            self.set_title("leaf")
            self.load()
        elif kind == "open-dialog":
            self.open_dialog()
        elif kind == "quit":
            self.destroy()

    def open_book(self, path):
        p = Path(path).expanduser().resolve()
        if p.is_file():
            self.book = p
            s = self.state
            s["books"].setdefault(str(p), {})["opened"] = time.time()
            save_state(s)
            self.load()

    def open_dialog(self):
        dlg = Gtk.FileChooserNative.new("Open book", self, Gtk.FileChooserAction.OPEN, "Open", "Cancel")
        flt = Gtk.FileFilter()
        flt.set_name("EPUB books")
        flt.add_mime_type("application/epub+zip")
        flt.add_pattern("*.epub")
        dlg.add_filter(flt)
        dlg.set_current_folder(str(self.book.parent if self.book else HOME))
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            self.open_book(dlg.get_filename())

    def tap(self):
        """Wood tap from PipeWire's sample cache (same sound as pomo's interface)."""
        try:
            if not self.tap_ready and TAP.exists():
                self.tap_ready = subprocess.run(["pactl", "upload-sample", str(TAP), "leaf-tap"],
                                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if self.tap_ready:
                subprocess.Popen(["pactl", "play-sample", "leaf-tap"], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def on_policy(self, _view, decision, kind):
        """Keep the reader inside leaf://; open external links in the browser."""
        if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if uri.startswith(("http://", "https://", "mailto:")):
                Gio.AppInfo.launch_default_for_uri(uri, None)
                decision.ignore()
                return True
        elif kind == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
            decision.ignore()
            return True
        return False


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    if not (ROOTS["app"] / "reader.html").exists() or not (ROOTS["foliate"] / "view.js").exists():
        sys.exit(f"leaf: app files not found under {SHARE} "
                 "(run from a checkout with 'git submodule update --init', or set LEAF_HOME)")
    book = sys.argv[1] if len(sys.argv) > 1 else None
    if book and not Path(book).is_file():
        sys.exit(f"leaf: no such file: {book}")
    GLib.set_prgname("leaf")          # Wayland app id / window class
    win = Leaf(book)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
